# ── Astra DB ────────────────────────────────────────────────────────────────
# The wiki stores topics, pages and sync state in the `wiki_toc_v2` collection,
# created on first use. It can share a database with other apps.
ASTRA_DB_API_ENDPOINT=https://<db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:...
# ASTRA_DB_KEYSPACE=default_keyspace          # optional

# ── LLM proxy (OpenAI-API-compatible: LiteLLM, OpenRouter, Ollama) ──────────
# LLM_MODEL is REQUIRED — there is no default. A silently wrong default model
# is worse than a missing-config error.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# JEV_MODEL=~typesafe/jev-latest              # optional; model for fast topic classification
# LLM_JSON_MODE=auto                          # auto | on | off

# ── GitHub ──────────────────────────────────────────────────────────────────
# Optional. Raises the GitHub API rate limit from 60 req/hr (unauthenticated)
# to 5 000 req/hr (authenticated). Sufficient for local dev without a token.
# Generate at: https://github.com/settings/tokens (no scopes needed for public repos)
# GITHUB_TOKEN=
